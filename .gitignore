# Only the active site's files belong in the publishing repository.
# Old experiments, local uploads, dependencies, and secrets stay on this computer.
/*
!/.gitignore
!/README.md
!/HOSTING.md
!/package-preview.js
!/designs/
/designs/*
!/designs/aire.html
!/designs/aire-motion.html
!/designs/aire-motion-about.html
!/designs/aire-motion-events.html
!/designs/aire-motion-join.html
!/designs/aire-motion-scholarships.html
!/designs/aire-motion-board.html
!/designs/build-community-pages.js
!/designs/aire-community.css
!/designs/aire-board.js
!/designs/build-aire-motion.js
!/designs/AIRE-MOTION.md
!/designs/styles.css
!/designs/aire-motion.css
!/designs/aire-motion.js
!/designs/aire-nav.css
!/designs/aire-nav.js
!/designs/aire-buttons.css
!/designs/aire-subpage.css
!/designs/aire-about.css
!/designs/aire-meetings.js
!/designs/silk-walker.css
!/designs/silk-walker.js
!/designs/walker-renderer.js
!/content/
/content/*
!/content/aire-meetings.json
!/content/aire-board.json
!/SCHOLARSHIP-NOTES.md
!/assets/
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/archivo-400.woff2
!/assets/fonts/archivo-600.woff2
!/assets/fonts/archivo-700.woff2
!/assets/fonts/instrument-serif-400.woff2
!/assets/fonts/instrument-serif-400-italic.woff2
!/assets/fonts/space-grotesk-500.woff2
!/assets/img/
