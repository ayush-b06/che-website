!/assets/img/PHOTO-SOURCES.md
!/assets/img/che-logo-64.jpg
!/assets/img/photos/
/assets/img/photos/*
!/assets/img/photos/che-*.jpg
!/assets/img/photos/che-*.png
!/assets/img/photos/che-*.webp
!/assets/img/marquee/
/assets/img/marquee/*
!/assets/img/marquee/che-*.jpg
!/assets/models/
/assets/models/*
!/assets/models/ATTRIBUTION.md
